# Modele de variables d'environnement. Copier ce fichier en ".env" et renseigner
# des valeurs reelles. Le fichier .env est ignore par git (ne jamais le committer).

# --- MySQL (patient-service) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=patientdb
MYSQL_USER=medilabo
MYSQL_PASSWORD=change-me

# --- MongoDB (notes-service) ---
MONGO_USER=medilabo
MONGO_PASSWORD=change-me
MONGO_DATABASE=notesdb
MONGO_APP_USER=change-me
MONGO_APP_PASSWORD=change-me

# --- Gateway (authentification HTTP Basic) ---
GATEWAY_AUTH_USERNAME=medilabo
GATEWAY_AUTH_PASSWORD=change-me

# Front (authentification form login, compte unique de demonstration)
FRONTEND_AUTH_USERNAME=medilabo
FRONTEND_AUTH_PASSWORD=change-me
